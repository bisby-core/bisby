{
  "version": 2,
  "public": true,
  "buildCommand": "pnpm --filter @workspace/bisby-web run build",
  "outputDirectory": "artifacts/bisby-web/dist/public",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "api/[...path].ts"
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "^(?<tenant>[^.]+)\\.bisby\\.pro$"
        }
      ],
      "destination": "/:path*"
    },
    {
      "source": "/(:path*)",
      "destination": "/$1"
    }
  ]
}
